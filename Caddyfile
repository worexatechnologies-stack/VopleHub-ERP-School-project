{
    servers {
        # Trust client-IP headers only from the Docker ingress network and
        # Cloudflare. Caddy then forwards a sanitized X-Forwarded-For to Nginx.
        trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

:80 {
    encode zstd gzip

    # Production Edge Security & Cross-Origin Isolation Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cross-Origin-Opener-Policy "same-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=()"
        -Server
    }

    handle_path /static/* {
        root * /srv/static
        file_server
        header {
            Cache-Control "public, max-age=2592000, immutable"
            Cross-Origin-Resource-Policy "cross-origin"
            X-Content-Type-Options "nosniff"
        }
    }

    # Route all application traffic through the Nginx security gateway and reverse proxy (web:80)
    # This guarantees rate limiting, anti-CSRF, tightened CORS, and security headers are enforced in production
    reverse_proxy web:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}
