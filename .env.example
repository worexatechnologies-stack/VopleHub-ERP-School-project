# Frontend API target. In production, nginx proxies /api to Django, so this can be same-origin.
VITE_API_BASE_URL=https://volpehub.education/api/v1
LOGIN_THROTTLE_RATE=10/min
# Super Admin bootstrap credentials used to pre-fill the Super Admin login tab.
# Keep in sync with BOOTSTRAP_SUPERADMIN_EMAIL / BOOTSTRAP_SUPERADMIN_PASSWORD in backend/.env.
VITE_SUPER_ADMIN_EMAIL=
VITE_SUPER_ADMIN_PASSWORD=
# Firebase web configuration is public. Use the exact values from Firebase
# Console > Project settings > Your apps > Web app. The VAPID key is under
# Cloud Messaging > Web Push certificates.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
