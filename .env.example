# Frontend Environment Configuration
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://api:8000

# Firebase Web Configuration (Public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Production API capacity (8-vCPU host starting point; measure before raising)
API_REPLICAS=2
WEB_CONCURRENCY=4
PGBOUNCER_MAX_CLIENT_CONN=5000
PGBOUNCER_DEFAULT_POOL_SIZE=50
RAZORPAY_DUMMY_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Automated PostgreSQL backup schedule and retention
BACKUP_DAILY_TIME=02:00
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_RETENTION_SECONDS=86400
