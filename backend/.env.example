DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.prod
DOMAIN=example.edu
LETSENCRYPT_EMAIL=admin@example.edu
POSTGRES_DB=volpehub_education
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-strong-bootstrap-database-password
APP_DB_USER=volpehub_education
APP_DB_PASSWORD=replace-with-strong-application-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://volpehub_education:replace-with-strong-application-database-password@db:5432/volpehub_education
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
ALLOWED_HOSTS=volpehub.education,www.volpehub.education,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=https://volpehub.education,https://www.volpehub.education
CSRF_TRUSTED_ORIGINS=https://volpehub.education,https://www.volpehub.education
DB_CONN_MAX_AGE=120
LOGIN_THROTTLE_RATE=10/min
WEB_CONCURRENCY=9
GUNICORN_TIMEOUT=90
CELERY_CONCURRENCY=4
FIREBASE_ENABLED=false
# Use one source only. JSON must be a single-line Firebase Admin service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative for a Docker/Kubernetes secret mounted read-only into the API and worker.
FIREBASE_SERVICE_ACCOUNT_FILE=
# These values are public and are forwarded only to the frontend Docker build.
VITE_API_BASE_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.edu
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_SUPERADMIN_NAME=Initial Super Admin
